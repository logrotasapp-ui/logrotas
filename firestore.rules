rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ── Dados do motorista (perfil + subcoleções) ──────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);

      // Checklists — contém CPF/RG/CNH de terceiros (LGPD)
      match /checklists/{checklistId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /fretes/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /despesas/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /manutencao/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /documentos/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /financeiro/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /entregas/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // Fechamento do dia (jornadas do motorista)
      match /jornadas/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
    }

    // ── Códigos beta (leitura autenticada + admin; gravação só Cloud Function) ─
    match /betaCodes/{codeId} {
      allow read: if request.auth != null || isAdmin();
      allow write: if false;
    }

    // ── Avaliações do app (feedback por estrelas) ─────────────────────────
    match /avaliacoes/{avaliacaoId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nota is int
        && request.resource.data.nota >= 1
        && request.resource.data.nota <= 5
        && request.resource.data.comentario is string
        && request.resource.data.calculadora is string
        && request.resource.data.nome is string
        && request.resource.data.email is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Configuração global (painel admin) ────────────────────────────────
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // Demais caminhos: negado implicitamente (sem match = sem acesso)
  }
}
