# Copie para .env e preencha com suas chaves:
#   cp .env.example .env
#
# No Vite, apenas variáveis com prefixo VITE_ ficam disponíveis no frontend.
# Reinicie o servidor (npm run dev) após alterar este arquivo.

# OpenRouteService — autocomplete de endereços e distância de rota (frete)
# https://openrouteservice.org/dev/#/signup
VITE_ORS_KEY=

# Google Maps — autocomplete, geocoding, mapa e otimização de entregas (Places + Directions API)
# https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_MAPS_KEY=

# Google Gemini — leitura de romaneio por foto
# https://aistudio.google.com/apikey
VITE_GEMINI_KEY=
