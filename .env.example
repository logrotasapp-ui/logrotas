# Copie para .env e preencha com suas chaves:
#   cp .env.example .env
#
# No Vite, apenas variáveis com prefixo VITE_ ficam disponíveis no frontend.
# Reinicie o servidor (npm run dev) após alterar este arquivo.

# OpenRouteService — autocomplete de endereços e distância de rota (frete)
# https://openrouteservice.org/dev/#/signup
VITE_ORS_KEY=

# Google Maps — autocomplete, geocoding, mapa e otimização de entregas (Places + Directions API)
# https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_MAPS_KEY=

# Google Cloud Vision — OCR de romaneio/etiquetas (TEXT_DETECTION)
# Extrai endereço de entrega; ignora destinatário, remetente e código de rastreio
# https://console.cloud.google.com/apis/library/vision.googleapis.com
VITE_GOOGLE_VISION_API_KEY=

# Firebase — autenticação e Firestore
# https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
